{
  "name": "apex-training-src",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:agent": "vite --mode agent",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "port": "node dev/port.mjs",
    "test": "vitest run",
    "e2e": "playwright test --project=mock",
    "eval": "tsx evals/run.ts",
    "eval:diff": "tsx evals/diff.ts",
    "eval:gate": "tsx evals/gate.ts run",
    "eval:baseline": "tsx evals/gate.ts baseline",
    "eval:hash": "tsx evals/gate.ts hash",
    "eval:verify": "tsx evals/gate.ts verify",
    "eval:label": "tsx evals/label.ts",
    "eval:agreement": "tsx evals/agreement.ts",
    "e2e:live": "scripts/with-stack-lock.sh sh -c 'scripts/preflight-local.sh --fix --quiet && APEX_LOCAL_SUPABASE=1 playwright test --project=live'",
    "db:types": "scripts/db-types.sh",
    "db:reset-local": "scripts/db-reset-local.sh",
    "db:restore-drill": "scripts/db-restore-drill.sh",
    "ci:guards": "scripts/ci-guards.sh",
    "agent:check": "npm run build && vitest run && oxlint && playwright test --project=mock && npm run ci:guards",
    "agent:check:full": "npm run agent:check && scripts/with-stack-lock.sh sh -c 'npm run db:reset-local && scripts/db-types.sh --check && APEX_LOCAL_SUPABASE=1 vitest run api/__tests__/integration && npm run e2e:live'",
    "fixtures:ios": "scripts/with-stack-lock.sh sh -c 'npm run db:reset-local && APEX_LOCAL_SUPABASE=1 APEX_FIXTURES_WRITE=1 vitest run api/__tests__/integration/ios-read'",
    "stack:check": "scripts/preflight-local.sh",
    "stack:fix": "scripts/preflight-local.sh --fix"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@garmin/fitsdk": "^21.218.0",
    "@hono/node-server": "^2.1.5",
    "@supabase/supabase-js": "^2.118.0",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.6.0",
    "hono": "^4.13.13",
    "lucide-react": "^1.61.0",
    "nodemailer": "^10.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-grid-layout": "2.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.309",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "^24.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
