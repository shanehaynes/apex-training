{
  "name": "apex-training-src",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": "22.x" },
  "scripts": {
    "dev": "vite",
    "dev:agent": "vite --mode agent",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "port": "node dev/port.mjs",
    "test": "vitest run",
    "e2e": "playwright test --project=mock",
    "eval": "tsx evals/run.ts",
    "eval:diff": "tsx evals/diff.ts",
    "eval:label": "tsx evals/label.ts",
    "eval:agreement": "tsx evals/agreement.ts",
    "e2e:live": "scripts/with-stack-lock.sh sh -c 'scripts/preflight-local.sh --fix --quiet && APEX_LOCAL_SUPABASE=1 playwright test --project=live'",
    "db:types": "scripts/db-types.sh",
    "db:reset-local": "scripts/db-reset-local.sh",
    "ci:guards": "scripts/ci-guards.sh",
    "agent:check": "tsc -b && vitest run && oxlint && playwright test --project=mock && npm run ci:guards",
    "agent:check:full": "npm run agent:check && scripts/with-stack-lock.sh sh -c 'npm run db:reset-local && APEX_LOCAL_SUPABASE=1 vitest run api/__tests__/integration && npm run e2e:live'",
    "stack:check": "scripts/preflight-local.sh",
    "stack:fix": "scripts/preflight-local.sh --fix"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@garmin/fitsdk": "^21.213.0",
    "@hono/node-server": "^2.1.1",
    "@supabase/supabase-js": "^2.112.3",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.1.1",
    "hono": "^4.13.3",
    "lucide-react": "^1.33.0",
    "nodemailer": "^9.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vercel/node": "^5.10.2",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
