// Shared build settings. Configuration-specific values live in Debug/Local/Release.
//
// `//` starts a comment in xcconfig, so a URL cannot be written literally —
// `https://host` truncates to `https:`. SLASH is the standard way around it.
SLASH = /

// The production project, already public in this repo (scripts/auth-redirect-check.sh
// has the same value, and the web ships it in every page load).
APEX_PROD_SUPABASE_URL = https:$(SLASH)$(SLASH)prmlzrkcfvmfapauoxqn.supabase.co

// The anon key is the one value not committed, so Secrets.xcconfig is a single
// line. AppConfig traps at launch while this sentinel is still in place, so a
// misconfigured build cannot ship quietly.
APEX_SUPABASE_ANON_KEY_PLACEHOLDER = REPLACE_ME
SUPABASE_ANON_KEY = $(APEX_SUPABASE_ANON_KEY_PLACEHOLDER)

// Apple Developer Team (public — it appears in every AASA file).
DEVELOPMENT_TEAM = G44GWSXFK2

#include? "Secrets.xcconfig"

// Where the sign-in screen sends someone who needs an account (W13): invite-only
// has to come with a way forward, not a dead end (App Store 5.1.1). A mailto:
// has no slashes, so it survives the comment rule above.
//
// The line below is the only place the shipped contact address lives. It runs
// Base.xcconfig -> Info.plist ($(APEX_INVITE_CONTACT)) -> AppConfig
// .inviteContactURL -> SignInView's "Request an invite" Link, and no other
// configuration overrides it (Debug/Local/Release do not set it). The web
// sign-in has no equivalent link at all, so there is nothing to keep in step.
//
// It ships inside the binary and is frozen there once the build is archived, in
// front of every scraper that downloads the app, so it must not stay a personal
// address (#214). Once the forwarding alias exists the swap is this one line:
//
//   sed -i 's|^APEX_INVITE_CONTACT = .*|APEX_INVITE_CONTACT = mailto:ALIAS?subject=Apex%20invite|' ios/Config/Base.xcconfig
//
// Only the label is drawn on screen ("Request an invite"), never the address, so
// no screenshot has to be retaken: the App Store set in docs/ios/app-store.md
// does not include the sign-in screen, and the committed snapshot of it
// (ApexTests/__Snapshots__/ScheduleSnapshotTests/testSignInScreen.1.png) shows
// the label only.
APEX_INVITE_CONTACT = mailto:shanehaynes.sah@gmail.com?subject=Apex%20invite

