# Copy to appstoreconnect.env (git-ignored) so ios/scripts/testflight.sh can
# archive and upload without opening Xcode.
#
# App Store Connect → Users and Access → Integrations → App Store Connect API
# → Team Keys → (+) → Access: "App Manager" → Generate.
#
# Download the .p8 immediately — Apple offers it exactly once — and put it at
#   ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8
#
# Neither id below is secret; the .p8 is, and it never enters this repo.
APEX_ASC_KEY_ID=
APEX_ASC_ISSUER_ID=
