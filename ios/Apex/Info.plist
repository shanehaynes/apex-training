<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Apex</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- Dark only (D-010). -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<!-- The app uses only HTTPS/TLS, which is exempt encryption. Declaring it here
	     means App Store Connect stops asking the export-compliance question on
	     every single upload; leaving it out blocks each build until answered. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Build configuration, filled in from ios/Config/*.xcconfig (D-022). -->
	<key>APEX_API_BASE</key>
	<string>$(APEX_API_BASE)</string>
	<key>SUPABASE_URL</key>
	<string>$(SUPABASE_URL)</string>
	<key>SUPABASE_ANON_KEY</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<key>APEX_CONFIGURATION</key>
	<string>$(CONFIGURATION)</string>
	<!-- The Local configuration talks to 127.0.0.1 over http, which ATS blocks by
	     default. NSAllowsLocalNetworking is the narrow exception: it permits
	     local addresses only and does not weaken anything for production. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- The web hand-off button (D-020); consumed in W2. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.shanehaynes.apextraining</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>apextraining</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
