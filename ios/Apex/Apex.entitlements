<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- aps-environment: the Live Activity is requested with pushType .token so
	     the server can end it by push when a workout finishes off the phone
	     (phase52). "development" here; exporting an archive for TestFlight or
	     the App Store re-signs it "production" from the distribution profile. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- applinks: universal links for /auth/* and /app/* (the AASA is served
	     from public/.well-known/ on every host Vercel attaches). webcredentials:
	     lets Password AutoFill offer the saved login on the sign-in screen.
	     apex-training.app is the origin the app ships against (D-049);
	     apextrainingcalendar.vercel.app stays listed so TestFlight builds
	     archived before the cut-over keep their links and saved passwords. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:apex-training.app</string>
		<string>webcredentials:apex-training.app</string>
		<string>applinks:apextrainingcalendar.vercel.app</string>
		<string>webcredentials:apextrainingcalendar.vercel.app</string>
	</array>
</dict>
</plist>
