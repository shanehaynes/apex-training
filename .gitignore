# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code local (per-machine) settings
.claude/settings.local.json

# Playwright
test-results/
playwright-report/
e2e/screenshots/
.vercel

# Cross-session state the supervisor scripts write into the primary checkout
# (merge audit log, locks) and the autonomous-merge kill switch
.claude/state/
.claude/AUTOMERGE_OFF

# iOS — the Xcode project is generated per worktree (XcodeGen, D-005); everything
# below is a build artifact or per-machine configuration.
ios/*.xcodeproj
ios/*.xcworkspace
ios/build/
ios/DerivedData/
ios/.swiftpm/
ios/Packages/*/.build/
ios/Packages/*/.swiftpm/
ios/Config/Secrets.xcconfig
ios/Config/*.local.xcconfig
ios/Config/appstoreconnect.env
